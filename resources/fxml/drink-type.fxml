<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.drink.controller.DrinkTypeController">
    <center>
        <VBox spacing="15" style="-fx-padding:10;">
            <!-- 查询区域 -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="分类名称：" style="-fx-font-size: 14px;"/>
                <TextField fx:id="searchName" prefWidth="200" promptText="输入分类名称"/>
                <Button text="查询" onAction="#search" style="-fx-background-color: #415f96; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 5 15;"/>
                <Button text="刷新" onAction="#refresh" style="-fx-font-size: 14px; -fx-padding: 5 15;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="返回首页" onAction="#close" style="-fx-font-size: 14px; -fx-padding: 5 15;"/>
            </HBox>

            <!-- 分类表格 -->
            <TableView fx:id="table" prefHeight="350">
                <columns>
                    <TableColumn fx:id="colId" text="编号" prefWidth="60"/>
                    <TableColumn fx:id="colTypeName" text="分类名称" prefWidth="100"/>
                    <TableColumn fx:id="colDrinks" text="包含饮料" prefWidth="600"/>
                    <TableColumn fx:id="colRemark" text="备注" prefWidth="150"/>
                </columns>
            </TableView>

            <!-- 分类信息维护 -->
            <VBox spacing="10" style="-fx-padding:5;">
                <Label text="分类信息维护" style="-fx-font-size:16; -fx-font-weight:bold;"/>

                <GridPane hgap="15" vgap="10">
                    <Label text="编号" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="tfId" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false" style="-fx-background-color: #f0f0f0;"/>

                    <Label text="分类名称" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="tfTypeName" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="200"/>

                    <Label text="备注说明" GridPane.rowIndex="0" GridPane.columnIndex="4" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="tfRemark" GridPane.rowIndex="0" GridPane.columnIndex="5" prefWidth="300"/>
                </GridPane>

                <!-- 按钮区域 -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:10 0 0 0;">
                    <Button text="新增分类" onAction="#add" style="-fx-background-color:#28a745;-fx-text-fill:white; -fx-font-size: 14px; -fx-padding: 8 20;"/>
                    <Button text="修改分类" onAction="#update" style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
                    <Button text="删除分类" onAction="#delete" style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
                    <Button text="重置" onAction="#reset" style="-fx-font-size: 14px; -fx-padding: 8 20;"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
