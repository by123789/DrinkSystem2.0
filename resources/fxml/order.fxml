<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.drink.controller.OrderController">

    <top>
        <VBox>
            <Label text="饮料订单查询" style="-fx-background-color: #347AB7; -fx-text-fill: white; -fx-padding: 15; -fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="10" style="-fx-padding: 15;">
                <!-- 第一行 -->
                <Label text="订单号" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="oid" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="下单用户" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="uname" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="饮料名" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
                <TextField fx:id="dname" GridPane.rowIndex="0" GridPane.columnIndex="5"/>

                <Label text="饮料类型" GridPane.rowIndex="0" GridPane.columnIndex="6"/>
                <ComboBox fx:id="tname" GridPane.rowIndex="0" GridPane.columnIndex="7"/>

                <Label text="收货人" GridPane.rowIndex="0" GridPane.columnIndex="8"/>
                <TextField fx:id="receiver" GridPane.rowIndex="0" GridPane.columnIndex="9"/>

                <!-- 第二行 -->
                <Label text="电话号码" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="phone" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="开始时间" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="start" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="结束时间" GridPane.rowIndex="1" GridPane.columnIndex="4"/>
                <TextField fx:id="end" GridPane.rowIndex="1" GridPane.columnIndex="5"/>

                <Label text="页号" GridPane.rowIndex="1" GridPane.columnIndex="6"/>
                <ComboBox fx:id="pageNo" GridPane.rowIndex="1" GridPane.columnIndex="7"/>

                <Button text="查询" onAction="#search" style="-fx-background-color: #5CB85C; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20;"
                        GridPane.rowIndex="1" GridPane.columnIndex="8"/>
            </GridPane>

            <HBox style="-fx-padding: 0 15 10 15;">
                <Label fx:id="pageInfo1" text="第1页 共1页"/>
                <Label fx:id="pageInfo2" text="共0条记录"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table" prefHeight="400">
            <columns>
                <TableColumn text="序号" prefWidth="60"/>
                <TableColumn fx:id="cid" text="oid" prefWidth="80"/>
                <TableColumn fx:id="cusername" text="下单用户" prefWidth="100"/>
                <TableColumn fx:id="ctname" text="饮料类型" prefWidth="100"/>
                <TableColumn fx:id="cdname" text="饮料名" prefWidth="120"/>
                <TableColumn fx:id="cnum" text="数量" prefWidth="60"/>
                <TableColumn fx:id="ctotal" text="总价" prefWidth="80"/>
                <TableColumn fx:id="creceiver" text="收货人" prefWidth="100"/>
                <TableColumn fx:id="caddress" text="派送地址" prefWidth="150"/>
                <TableColumn fx:id="cphone" text="联系电话" prefWidth="120"/>
                <TableColumn fx:id="ctime" text="下单时间" prefWidth="150"/>
            </columns>
        </TableView>
    </center>
</BorderPane>