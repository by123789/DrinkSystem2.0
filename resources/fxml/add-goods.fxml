<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<AnchorPane prefWidth="400" prefHeight="300"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.drink.controller.AddGoodsController">
    <Label text="商品名称" layoutX="50" layoutY="50"/>
    <TextField fx:id="nameField" layoutX="120" layoutY="45" prefWidth="200"/>

    <Button text="保存" onAction="#save" layoutX="100" layoutY="200"/>
    <Button text="取消" onAction="#cancel" layoutX="220" layoutY="200"/>
</AnchorPane>