<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="20" prefWidth="400" prefHeight="320"
      xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.drink.controller.LoginController">
    <Label text="饮料系统登录" style="-fx-font-size:24px;"/>
    <TextField fx:id="username" promptText="账号"/>
    <PasswordField fx:id="password" promptText="密码"/>
    <Button text="登录" onAction="#login"/>
    <HBox spacing="40">
        <Hyperlink text="注册" onAction="#goRegister"/>
        <Hyperlink text="忘记密码" onAction="#goForget"/>
    </HBox>
</VBox>