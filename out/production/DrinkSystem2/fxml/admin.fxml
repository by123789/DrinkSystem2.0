<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.drink.controller.AdminController">
    <top>
        <HBox spacing="20" style="-fx-padding:10;">
            <Label text="管理员后台" style="-fx-font-size:18; -fx-font-weight:bold"/>
            <Region HBox.hgrow="ALWAYS"/>


        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding:10;">
            <!-- 查询区域 -->
            <HBox spacing="15">
                <Label text="商品名称"/>
                <TextField fx:id="searchName" prefWidth="150"/>
                <Label text="商品分类"/>
                <ComboBox fx:id="searchCategory" prefWidth="150"/>
                <Button text="查询" onAction="#search"/>
                <Button text="刷新" onAction="#refresh"/>
            </HBox>

            <!-- 商品表格 -->
            <TableView fx:id="table" prefHeight="320">
                <columns>
                    <TableColumn fx:id="id" text="编号" prefWidth="80"/>
                    <TableColumn fx:id="name" text="名称" prefWidth="120"/>
                    <TableColumn fx:id="price" text="价格" prefWidth="80"/>
                    <TableColumn fx:id="stock" text="库存" prefWidth="80"/>
                    <TableColumn fx:id="category" text="分类" prefWidth="100"/>
                    <TableColumn fx:id="supplier" text="供应商" prefWidth="120"/>
                    <TableColumn fx:id="brand" text="品牌" prefWidth="100"/>
                    <TableColumn fx:id="spec" text="规格" prefWidth="100"/>
                    <TableColumn fx:id="status" text="状态" prefWidth="80"/>
                </columns>
            </TableView>

            <!-- 商品信息维护（新增：编号只读、新增按钮） -->
            <VBox spacing="10" style="-fx-padding:5;">
                <Label text="商品信息维护" style="-fx-font-size:16; -fx-font-weight:bold"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="编号" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfId"  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="名称" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="tfName" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="价格" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
                    <TextField fx:id="tfPrice" GridPane.rowIndex="0" GridPane.columnIndex="5"/>

                    <Label text="库存" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfStock" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="分类" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <ComboBox fx:id="tfCategory" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Label text="供应商" GridPane.rowIndex="1" GridPane.columnIndex="4"/>
                    <TextField fx:id="tfSupplier" GridPane.rowIndex="1" GridPane.columnIndex="5"/>

                    <Label text="品牌" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="tfBrand" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="规格" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <TextField fx:id="tfSpec" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                    <Label text="状态" GridPane.rowIndex="2" GridPane.columnIndex="4"/>
                    <ComboBox fx:id="tfStatus" GridPane.rowIndex="2" GridPane.columnIndex="5"/>
                </GridPane>

                <!-- 按钮：新增、修改、删除、重置 -->
                <HBox spacing="15" alignment="CENTER" style="-fx-padding:5;">
                    <Button text="新增商品" onAction="#add" style="-fx-background-color:#28a745;-fx-text-fill:white"/>
                    <Button text="修改商品" onAction="#update"/>
                    <Button text="删除商品" onAction="#delete"/>
                    <Button text="重置" onAction="#reset"/>

                </HBox>
                <!-- 按钮：新增、修改、删除、重置、用户管理 -->


            </VBox>
        </VBox>
    </center>
</BorderPane>