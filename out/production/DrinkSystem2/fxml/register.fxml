<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="15" prefWidth="450" prefHeight="500"
      xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.drink.controller.RegisterController">
    <Label text="用户注册" style="-fx-font-size:24px;"/>
    <TextField fx:id="username" promptText="请输入账号"/>
    <PasswordField fx:id="password" promptText="请输入密码"/>
    <PasswordField fx:id="repassword" promptText="请确认密码"/>
    <TextField fx:id="age" promptText="请输入年龄"/>
    <TextField fx:id="phone" promptText="请输入手机号"/>
    <TextField fx:id="address" promptText="请输入地址"/>
    <ComboBox fx:id="gender" promptText="请选择性别" prefWidth="380"/>
    <TextField fx:id="hobby" promptText="请输入爱好"/>
    <Button text="立即注册" onAction="#register"/>
    <Hyperlink text="已有账号？返回登录" onAction="#back"/>
</VBox>
